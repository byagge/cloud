[Unit]
Description=ARIX Cloud Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/cloud
EnvironmentFile=/opt/cloud/.env
ExecStart=/opt/cloud/venv/bin/python -m app.bot.main
Restart=on-failure
RestartSec=5
PrivateTmp=true

[Install]
WantedBy=multi-user.target
