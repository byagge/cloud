[Unit]
Description=ARIX Cloud job worker (only if EMBEDDED_WORKER=false + real Redis)
After=network-online.target arix-bot.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/cloud
EnvironmentFile=/opt/cloud/.env
ExecStart=/opt/cloud/venv/bin/python -m app.worker
Restart=on-failure
RestartSec=5
PrivateTmp=true

[Install]
WantedBy=multi-user.target
