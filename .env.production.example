# Production without Docker — copy to .env on the server:
#   cp .env.production.example .env
# Do not commit .env.

ENV=prod
BOT_TOKEN=CHANGE_ME
BOT_MODE=polling
PUBLIC_BASE_URL=http://127.0.0.1:18080
TG_WEBHOOK_SECRET=CHANGE_ME_long_random_32plus
OWNER_TG_ID=CHANGE_ME
ADMIN_CHAT_ID=CHANGE_ME

# Isolated local DB — does not touch other projects' Postgres
DATABASE_URL=sqlite+aiosqlite:///./data/arix.db
REDIS_URL=memory://
EMBEDDED_WORKER=true

# Unique localhost port (leave 80/8080 for other apps)
HTTP_HOST=127.0.0.1
HTTP_PORT=18080

PARTNER_BASE_URL=https://api.tihost.example
PARTNER_API_KEY=CHANGE_ME
PARTNER_WRITE_LIMIT=9
PARTNER_READ_LIMIT=50
USE_FAKE_PARTNER=false

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=CHANGE_ME

WEBHOOK_PATH_SECRET=CHANGE_ME_long_random_32plus
GATEWAY=fake

SUPPORT_URL=https://t.me/arxixx
TERMS_URL=https://example.com/terms
DEFAULT_LANG=ru
SENTRY_DSN=
