# Production template — copy to .env on the server:
#   cp .env.production.example .env
# Fill every CHANGE_ME value. Do not commit .env.

ENV=prod
BOT_TOKEN=CHANGE_ME
BOT_MODE=polling
PUBLIC_BASE_URL=https://your-domain.example
TG_WEBHOOK_SECRET=CHANGE_ME_long_random_32plus
OWNER_TG_ID=CHANGE_ME
ADMIN_CHAT_ID=CHANGE_ME

# Overridden by docker-compose for bot/worker; keep for local tools
POSTGRES_USER=arix
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=arix
DATABASE_URL=postgresql+asyncpg://arix:CHANGE_ME_strong_password@postgres:5432/arix
REDIS_URL=redis://redis:6379/0
EMBEDDED_WORKER=false

# Unique host bind so other projects keep 8080/5432/6379
ARIXX_HTTP_PORT=18080
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

PARTNER_BASE_URL=https://api.tihost.example
PARTNER_API_KEY=CHANGE_ME
PARTNER_WRITE_LIMIT=9
PARTNER_READ_LIMIT=50
USE_FAKE_PARTNER=false

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=CHANGE_ME

WEBHOOK_PATH_SECRET=CHANGE_ME_long_random_32plus
GATEWAY=fake

SUPPORT_URL=https://t.me/arxixx
TERMS_URL=https://example.com/terms
DEFAULT_LANG=ru
SENTRY_DSN=
